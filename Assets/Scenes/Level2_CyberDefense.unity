--- !u!114 &715664540
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 715664539}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1f0c0de000000000000000000000107, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  clip: {fileID: 0}
  videoUrl: 
  slides:
  - title: CYBER DEFENSE
    body: 'Welcome to the Security Operations Center. Defenders do three things:
      they WATCH (SIEM), they CATCH what gets through (EDR), and they RESPOND in
      a disciplined order (Incident Response).'
    duration: 10
  - title: SIEM
    body: "A SIEM collects events from every system and raises alerts. The hard part
      isn't seeing alerts \u2014 it's volume. Most are noise. Miss the real one in
      the flood and the attacker wins. That's alert fatigue."
    duration: 11
  - title: EDR
    body: "Endpoint Detection & Response watches what actually RUNS on machines.
      Malware hides behind normal-looking names \u2014 a PDF that's really an .exe,
      PowerShell running encoded commands. Find it, then isolate the endpoint."
    duration: 11
  - title: INCIDENT RESPONSE
    body: 'When something is real, you follow the playbook in ORDER: Preparation,
      Detection & Analysis, Containment, Eradication, Recovery, and Post-Incident
      review. Skipping steps destroys evidence or reinfects the network.'
    duration: 12
  scrubSecondsPerSecond: 8
  controlRange: 7
  screenRenderer: {fileID: 1836467655}
  titleText: {fileID: 1261943521}
  bodyText: {fileID: 1894502252}
  barFill: {fileID: 458028142}
